{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Program",
      "program": "${workspaceFolder}/src/main.ts",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "outFiles": ["${workspaceFolder}/lib/**/*.js"],
      "sourceMaps": true,
      "runtimeArgs": [
        "-r",
        "ts-node/register"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Jest Tests",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/node_modules/.bin/jest", // Chemin vers jest
      "args": [
        "--runInBand", // Exécuter les tests de manière synchrone (utile pour le débogage)
        "--coverage" // Facultatif : pour obtenir la couverture des tests
      ],
      "console": "integratedTerminal",
      "outFiles": [
        "${workspaceFolder}/lib/**/*.js"
      ],
      "sourceMaps": true,
      "runtimeArgs": [
        "-r", 
        "ts-node/register"
      ],
      "env": {
        "NODE_ENV": "test"
      }
    }
  ]
}