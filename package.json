{
  "name": "action-cli",
  "version": "0.1.0",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc && ncc build",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "test": "export $(cat .env | xargs) && jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upsun/action-cli.git"
  },
  "keywords": [
    "github",
    "actions",
    "upsun",
    "cli"
  ],
  "author": "Mickael GAILLARD",
  "license": "Apache-2.0",
  "description": "Install Upsun CLI",
  "bugs": {
    "url": "https://github.com/upsun/action-cli/issues"
  },
  "homepage": "https://github.com/upsun/action-cli#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.0",
    "@actions/io": "^1.1.3"
  },
  "devDependencies": {
    "@github/local-action": "^2.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
